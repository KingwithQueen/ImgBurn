  </ItemGroup>
  <ItemGroup Condition="Exists('$(ImgBurnResourceSource)\icons\MAINICON.ico')">
    <ResourceCompile Include="src\imgburn_app.rc">
      <AdditionalIncludeDirectories>$(ImgBurnResourceSource);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemGroup>
  <Target Name="CopyImgBurnReferenceAssets" AfterTargets="Build" Condition="'@(ImgBurnReferenceAsset)'!=''">
    <Copy SourceFiles="@(ImgBurnReferenceAsset)" DestinationFiles="@(ImgBurnReferenceAsset->'$(OutDir)resources\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
